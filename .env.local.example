# DeepSeek API
DEEPSEEK_API_KEY=

# OpenAI API — used by the vision endpoint AND the cross-model judge
# (npm run evals:crossjudge, which measures same-family judge bias).
OPENAI_API_KEY=
# Independent cross-judge (default: openai:gpt-4o-mini). Claude works too:
#   JUDGE_MODEL_CROSS=anthropic:claude-sonnet-4-6   (needs ANTHROPIC_API_KEY)
# JUDGE_MODEL_CROSS=anthropic:claude-sonnet-4-6

# Anthropic API — only needed if the cross-judge is an anthropic:* model
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public deployment hardening
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_SECRET=
MCP_AUTH_TOKEN=
# Optional bearer token for detailed /api/healthz dependency diagnostics.
# Hosted deployments return only status/version without it.
HEALTHCHECK_TOKEN=
# Set to true only when intentionally exposing MCP/webhook without auth.
ALLOW_PUBLIC_MACHINE_API=false
# Temporary compatibility for integrations that still put webhook secrets in URLs.
# Prefer Authorization: Bearer and leave this disabled.
ALLOW_LEGACY_QUERY_SECRET=false

# Persisted incident logs are private by default in production and Vercel previews.
# Set this only for a deployment that contains sample data and is intentionally public.
ALLOW_PUBLIC_INCIDENT_DATA=false
# Machine clients can read/rerun private incidents with this bearer token.
# Falls back to WEBHOOK_SECRET when omitted.
INCIDENT_ACCESS_TOKEN=

# Optional distributed rate limiting. When omitted, local in-memory counters
# are used; production should configure both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
